    "cz_search": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Search Czech acts by year and/or a citation substring.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "contains": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "substring matched (case-insensitive) against the citation, e.g. ``\"110\"``."
            },
            "limit": {
              "default": 50,
              "description": "max hits (1..500, default 50).",
              "type": "integer"
            },
            "offset": {
              "default": 0,
              "description": "pagination offset (default 0).",
              "type": "integer"
            },
            "year": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "restrict to a publication year, e.g. ``2019``."
            }
          },
          "type": "object"
        },
        "meta": {
